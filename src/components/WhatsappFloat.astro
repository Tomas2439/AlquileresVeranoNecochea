---
import { WHATSAPP_URL } from '../data/alojamientos';
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Consultar por WhatsApp"
  class="fixed right-4 bottom-4 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[var(--border-soft)] bg-terracotta text-cream shadow-[var(--shadow-warm)] hover:bg-terracotta-h md:hidden"
>
  <svg
    class="h-7 w-7"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
</a>
