---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

function parseVideoSource(rawUrl: string): {
  type: 'iframe' | 'file';
  src: string;
} | null {
  if (!rawUrl) return null;

  if (/\.(mp4|webm|ogg)(\?.*)?$/i.test(rawUrl) || rawUrl.startsWith('/')) {
    return { type: 'file', src: rawUrl };
  }

  try {
    const parsed = new URL(rawUrl);

    if (parsed.hostname.includes('youtube.com')) {
      const vId = parsed.searchParams.get('v');
      if (vId) {
        return {
          type: 'iframe',
          src: `https://www.youtube-nocookie.com/embed/${vId}?autoplay=1`,
        };
      }
      const shortsMatch = parsed.pathname.match(/\/shorts\/([^/?]+)/);
      if (shortsMatch?.[1]) {
        return {
          type: 'iframe',
          src: `https://www.youtube-nocookie.com/embed/${shortsMatch[1]}?autoplay=1`,
        };
      }
    }

    if (parsed.hostname === 'youtu.be') {
      const id = parsed.pathname.slice(1).split('/')[0];
      if (id) {
        return {
          type: 'iframe',
          src: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`,
        };
      }
    }

    if (parsed.hostname.includes('vimeo.com')) {
      const id = parsed.pathname.split('/').filter(Boolean).pop();
      if (id) {
        return {
          type: 'iframe',
          src: `https://player.vimeo.com/video/${id}?autoplay=1`,
        };
      }
    }
  } catch {
    return null;
  }

  return null;
}

const videoSource = parseVideoSource(url);
---

{
  videoSource &&
    (videoSource.type === 'file' ? (
      <div class="overflow-hidden rounded-[12px] border border-border bg-surface shadow-[var(--shadow-warm)]">
        <video
          controls
          preload="metadata"
          playsinline
          class="aspect-video w-full bg-dark object-contain"
          aria-label={title}
        >
          <source src={videoSource.src} />
          Tu navegador no soporta la reproducción de video.
        </video>
        <p class="border-t border-border px-4 py-2.5 text-sm font-medium text-text">
          {title}
        </p>
      </div>
    ) : (
      <div
        data-video-embed={videoSource.src}
        data-video-title={title}
        class="relative aspect-video w-full overflow-hidden rounded-[12px] border border-border bg-surface shadow-[var(--shadow-warm)]"
      >
        <button
          type="button"
          data-video-trigger
          aria-label={`Reproducir video: ${title}`}
          class="flex h-full w-full cursor-pointer flex-col items-center justify-center gap-3 p-6 text-text hover:text-accent"
          style="background: var(--photo-fallback);"
        >
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-accent text-white shadow-[var(--shadow-warm)]">
            <svg class="ml-0.5 h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="text-sm font-semibold text-text">{title}</span>
          <span class="text-sm text-text-muted">Tocar para reproducir el video</span>
        </button>
      </div>
    ))
}

<script>
  document.querySelectorAll<HTMLElement>('[data-video-embed]').forEach((wrapper) => {
    const trigger = wrapper.querySelector('[data-video-trigger]');
    const embedUrl = wrapper.getAttribute('data-video-embed');
    const title = wrapper.getAttribute('data-video-title') ?? 'Video';

    trigger?.addEventListener('click', () => {
      if (!embedUrl) return;
      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = title;
      iframe.loading = 'lazy';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'h-full w-full border-0';
      wrapper.replaceChildren(iframe);
    });
  });
</script>
