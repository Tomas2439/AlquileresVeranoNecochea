---
import { WHATSAPP_URL } from '../data/alojamientos';
---

<section class="border-t border-[var(--border-soft)] bg-bg-deep py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2
      class="font-serif font-medium tracking-[-0.015em] text-cream"
      style="font-size: var(--text-h2); line-height: 1.12;"
    >
      ¿Querés consultar fechas disponibles?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-sand">
      Escribinos directo por WhatsApp y coordinamos tu estadía en Necochea.
    </p>
    <div class="mt-8">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>
