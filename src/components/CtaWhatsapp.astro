---
import { getWhatsappUnitUrl } from '../data/alojamientos';

interface Props {
  unidadNombre?: string;
}

const { unidadNombre } = Astro.props;
const whatsappHref = getWhatsappUnitUrl(unidadNombre);
---

<section class="border-t border-border bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2
      class="font-serif font-medium tracking-[-0.015em] text-text"
      style="font-size: var(--text-h2); line-height: 1.12;"
    >
      {unidadNombre ? `¿Querés consultar por ${unidadNombre}?` : '¿Querés consultar fechas disponibles?'}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-text-muted">
      Escribinos directo por WhatsApp y coordinamos tu estadía en Necochea.
    </p>
    <div class="mt-8">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>
