---
import LogoAvn from './LogoAvn.astro';
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  WHATSAPP_URL,
} from '../data/alojamientos';
---

<footer class="bg-dark py-12 pb-24 text-dark-text md:pb-12">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
    <a href="/" aria-label="AVN – Volver al inicio">
      <LogoAvn variant="footer" />
    </a>

    <div class="flex flex-col gap-3 sm:items-end">
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-dark-muted hover:text-dark-text"
      >
        {INSTAGRAM_HANDLE}
      </a>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-dark-text underline decoration-[var(--accent-on-dark)] underline-offset-4 hover:text-dark-muted"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</footer>
