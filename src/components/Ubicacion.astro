---
import { getUnidadesByZona, ZONAS } from '../data/alojamientos';
---

<section id="ubicacion" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2
        class="font-serif font-medium tracking-[-0.015em] text-text"
        style="font-size: var(--text-h2); line-height: 1.1;"
      >
        Dónde están
      </h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        Cada zona de alojamiento está en un sector diferente de Necochea, cerca de la costa, el parque o el centro.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-stretch">
      <!-- Mapa de referencia interactivo (arriba en mobile con altura fija 280px, izquierda en desktop) -->
      <div class="relative h-[280px] overflow-hidden rounded-[12px] border border-border bg-surface shadow-[var(--shadow-warm)] lg:col-span-6 lg:h-auto lg:min-h-[420px]">
        <svg
          viewBox="0 0 100 100"
          preserveAspectRatio="xMidYMid slice"
          class="h-full w-full"
          role="img"
          aria-label="Mapa de referencia de las tres zonas de alojamiento en Necochea frente a la costa"
        >
          <!-- Tierra / Arena -->
          <rect width="100" height="100" fill="#F3E9D8" />
          <!-- Parque / Área verde -->
          <path d="M12 20 Q38 14 55 32 Q50 56 26 58 Q8 46 12 20 Z" fill="#DDE6D5" />
          <!-- Trama urbana centro -->
          <g stroke="#E3D6C4" stroke-width="0.6">
            <line x1="60" y1="16" x2="90" y2="16" />
            <line x1="60" y1="26" x2="90" y2="26" />
            <line x1="60" y1="36" x2="90" y2="36" />
            <line x1="66" y1="10" x2="66" y2="44" />
            <line x1="76" y1="10" x2="76" y2="44" />
            <line x1="86" y1="10" x2="86" y2="44" />
          </g>
          <!-- Franja de playa -->
          <path d="M0 78 Q35 68 65 56 T100 44 L100 100 L0 100 Z" fill="#E8DAC3" />
          <!-- Mar Argentino -->
          <path d="M0 84 Q35 74 65 62 T100 50 L100 100 L0 100 Z" fill="#C7DCE0" />
          <path d="M0 84 Q35 74 65 62 T100 50" fill="none" stroke="#1F6F78" stroke-width="0.7" stroke-opacity="0.45" />
          <text x="58" y="88" fill="#165259" font-size="4.2" font-family="Poppins, sans-serif" font-weight="500">
            Mar Argentino · Costa de Necochea
          </text>
        </svg>

        <!-- Pines interactivos por zona -->
        {
          ZONAS.map((zona, idx) => (
            <button
              type="button"
              data-map-pin={zona.slug}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              style={`left: ${zona.mapPin.x}%; top: ${zona.mapPin.y}%;`}
              class={`group absolute -translate-x-1/2 -translate-y-full cursor-pointer focus-visible:z-30 ${
                idx === 0 ? 'z-20' : 'z-10'
              }`}
            >
              <span
                class={`inline-flex min-h-[36px] items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-semibold shadow-sm ${
                  idx === 0
                    ? 'border-accent bg-accent text-white'
                    : 'border-accent bg-surface text-text hover:bg-accent hover:text-white'
                }`}
              >
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
                </svg>
                <span>{zona.nombre}</span>
              </span>
            </button>
          ))
        }

        <span class="pointer-events-none absolute top-3 left-3 rounded-[8px] border border-border bg-surface/95 px-2.5 py-1 text-sm text-text-muted">
          Mapa provisorio · ubicación aproximada
        </span>
      </div>

      <!-- Lista sincronizada por zona (derecha en desktop, debajo en mobile) -->
      <div class="flex flex-col gap-4 lg:col-span-6">
        {
          ZONAS.map((zona, idx) => {
            const unidades = getUnidadesByZona(zona.slug);
            return (
              <div
                data-zone-card={zona.slug}
                tabindex="0"
                class={`cursor-pointer rounded-[12px] border bg-surface p-5 transition-colors ${
                  idx === 0
                    ? 'border-accent shadow-[var(--shadow-warm)]'
                    : 'border-border hover:border-accent/60'
                }`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-serif text-2xl font-semibold text-text">
                    {zona.nombre}
                  </h3>
                  {zona.distanciaMar && (
                    <span class="text-sm font-medium text-accent">{zona.distanciaMar}</span>
                  )}
                </div>

                <p class="mt-1 text-sm text-text-muted">{zona.barrio}</p>

                {zona.referencias.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {zona.referencias.map((ref) => (
                      <li class="rounded-[8px] border border-border bg-bg px-2.5 py-1 text-sm text-text-muted">
                        {ref}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-4 flex flex-wrap gap-3 border-t border-border pt-3">
                  {unidades.map((u) => (
                    <a
                      href={`/alojamientos/${u.slug}`}
                      class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent underline underline-offset-4 hover:text-text"
                    >
                      {u.nombre}
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  const pins = document.querySelectorAll<HTMLButtonElement>('[data-map-pin]');
  const cards = document.querySelectorAll<HTMLElement>('[data-zone-card]');

  function selectZone(slug: string) {
    pins.forEach((pin) => {
      const active = pin.getAttribute('data-map-pin') === slug;
      pin.setAttribute('aria-pressed', String(active));
      pin.classList.toggle('z-20', active);
      pin.classList.toggle('z-10', !active);
      const pill = pin.querySelector('span');
      if (pill) {
        pill.classList.toggle('bg-accent', active);
        pill.classList.toggle('text-white', active);
        pill.classList.toggle('bg-surface', !active);
        pill.classList.toggle('text-text', !active);
      }
    });

    cards.forEach((card) => {
      const active = card.getAttribute('data-zone-card') === slug;
      card.classList.toggle('border-accent', active);
      card.classList.toggle('shadow-[var(--shadow-warm)]', active);
      card.classList.toggle('border-border', !active);
    });
  }

  pins.forEach((pin) => {
    pin.addEventListener('click', () => {
      const slug = pin.getAttribute('data-map-pin');
      if (slug) selectZone(slug);
    });
  });

  cards.forEach((card) => {
    card.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      const slug = card.getAttribute('data-zone-card');
      if (slug) selectZone(slug);
    });
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const slug = card.getAttribute('data-zone-card');
        if (slug) selectZone(slug);
      }
    });
  });
</script>
