---
import { getUnidadesByGrupo, GRUPOS_ALOJAMIENTO } from '../data/alojamientos';
---

<section id="ubicacion" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2
        class="font-serif font-medium tracking-[-0.015em] text-text"
        style="font-size: var(--text-h2); line-height: 1.1;"
      >
        Dónde estamos
      </h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        Consultá en el mapa la ubicación de preferencia en Necochea y su distancia a pie hasta la playa.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-stretch">
      <!-- Mapa real de Google Maps (arriba en mobile con alto fijo ~280px, izquierda en desktop).
           Se carga únicamente el iframe del alojamiento activo. -->
      <div class="relative h-[280px] overflow-hidden rounded-[12px] border border-border bg-surface shadow-[var(--shadow-warm)] lg:col-span-7 lg:h-auto lg:min-h-[420px]">
        <iframe
          id="ubicacion-map-iframe"
          src={GRUPOS_ALOJAMIENTO[0].mapEmbedUrl}
          title={`Mapa de ubicación de ${GRUPOS_ALOJAMIENTO[0].nombre} en Necochea`}
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="h-full w-full"
        />
      </div>

      <!-- Único control selector de ubicación: tarjetas a la derecha en desktop y debajo en mobile -->
      <div
        role="region"
        aria-label="Seleccionar alojamiento para ver en el mapa"
        class="flex flex-col gap-4 lg:col-span-5"
      >
        {
          GRUPOS_ALOJAMIENTO.map((grupo, idx) => {
            const unidades = getUnidadesByGrupo(grupo.slug);
            return (
              <div
                data-group-card={grupo.slug}
                data-map-src={grupo.mapEmbedUrl}
                data-map-title={`Mapa de ubicación de ${grupo.nombre} en Necochea`}
                role="button"
                tabindex="0"
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class={`cursor-pointer rounded-[12px] border bg-surface p-5 transition-colors ${
                  idx === 0
                    ? 'border-accent shadow-[var(--shadow-warm)]'
                    : 'border-border hover:border-accent/60'
                }`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-serif text-2xl font-semibold text-text">
                    {grupo.nombre}
                  </h3>
                  {grupo.distanciaMar && (
                    <span class="text-sm font-medium text-accent">{grupo.distanciaMar}</span>
                  )}
                </div>

                <p class="mt-1 text-sm text-text-muted">{grupo.barrio}</p>

                {grupo.referencias.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {grupo.referencias.map((ref) => (
                      <li class="rounded-[8px] border border-border bg-bg px-2.5 py-1 text-sm text-text-muted">
                        {ref}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-4 flex flex-wrap gap-3 border-t border-border pt-3">
                  {unidades.map((u) => (
                    <a
                      href={`/alojamientos/${u.slug}`}
                      class="inline-flex min-h-[44px] items-center text-sm font-semibold text-accent underline underline-offset-4 hover:text-text"
                    >
                      {u.nombre}
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  const mapIframe = document.getElementById('ubicacion-map-iframe') as HTMLIFrameElement | null;
  const cards = document.querySelectorAll<HTMLElement>('[data-group-card]');

  function selectGroup(slug: string) {
    cards.forEach((card) => {
      const active = card.getAttribute('data-group-card') === slug;
      card.setAttribute('aria-pressed', String(active));
      card.classList.toggle('border-accent', active);
      card.classList.toggle('shadow-[var(--shadow-warm)]', active);
      card.classList.toggle('border-border', !active);

      if (active && mapIframe) {
        const nextSrc = card.getAttribute('data-map-src');
        const nextTitle = card.getAttribute('data-map-title');
        if (nextSrc && mapIframe.getAttribute('src') !== nextSrc) {
          mapIframe.setAttribute('src', nextSrc);
        }
        if (nextTitle) {
          mapIframe.setAttribute('title', nextTitle);
        }
      }
    });
  }

  cards.forEach((card) => {
    card.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      const slug = card.getAttribute('data-group-card');
      if (slug) selectGroup(slug);
    });
    card.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const slug = card.getAttribute('data-group-card');
        if (slug) selectGroup(slug);
      }
    });
  });
</script>
