---
import { Image } from 'astro:assets';
import { getFolderImages } from '../utils/media';

const entornoImages = getFolderImages('entorno');
---

<section id="ubicacion" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <h2
          class="font-serif font-medium tracking-[-0.015em] text-cream"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Ubicación
        </h2>
        <p class="mt-4 text-base leading-relaxed text-sand">
          Cabañas en Villa del Deportista, Necochea. Cabañas para 4 personas y depto en zona céntrica para 4/5 personas.
        </p>
      </div>

      <div class="lg:col-span-7">
        {
          entornoImages.length > 0 ? (
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
              {entornoImages.slice(0, 6).map((img, index) => (
                <div class="aspect-[4/3] overflow-hidden rounded-[12px] border border-[var(--border-soft)] bg-surface">
                  <Image
                    src={img}
                    alt={`Entorno de Villa del Deportista y Necochea – foto ${index + 1}`}
                    loading="lazy"
                    widths={[360, 640]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="reveal-on-scroll flex aspect-[16/9] w-full items-center justify-center rounded-[12px] border border-[var(--border-soft)] bg-surface p-6 text-center">
              <span class="label-kicker rounded-[10px] border border-[var(--border-soft)] bg-bg-deep px-3 py-1.5">
                FOTO PENDIENTE – entorno
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
