---
---

<section
  id="estadia"
  class="bg-dark py-16 text-dark-text sm:py-24"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <h2
          class="font-serif font-medium tracking-[-0.015em] text-dark-text"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Tu estadía
        </h2>
        <p class="mt-3 text-base leading-relaxed text-dark-muted">
          Horarios pensados para que llegues sin apuro y organices tu viaje con comodidad.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-7">
        <div class="reveal-on-scroll rounded-[12px] border border-[var(--border-dark)] bg-white/5 p-6 sm:p-8">
          <p class="text-sm font-medium text-dark-muted">Check-in</p>
          <p class="mt-2 font-serif text-4xl font-semibold tracking-[-0.01em] text-dark-text sm:text-5xl">
            14:00 hs
          </p>
          <p class="mt-2 text-sm leading-relaxed text-dark-muted">
            Ingreso desde las 2 de la tarde.
          </p>
        </div>

        <div class="reveal-on-scroll rounded-[12px] border border-[var(--border-dark)] bg-white/5 p-6 sm:p-8">
          <p class="text-sm font-medium text-dark-muted">Check-out</p>
          <p class="mt-2 font-serif text-4xl font-semibold tracking-[-0.01em] text-dark-text sm:text-5xl">
            10:00 hs
          </p>
          <p class="mt-2 text-sm leading-relaxed text-dark-muted">
            Egreso hasta las 10 de la mañana.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
