---
---

<section
  id="estadia"
  class="border-y border-[var(--border-soft)] bg-bg-deep py-16 sm:py-24"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <h2
          class="font-serif font-medium tracking-[-0.015em] text-cream"
          style="font-size: var(--text-h2); line-height: 1.1;"
        >
          Info de tu estadía
        </h2>
        <p class="mt-3 text-base leading-relaxed text-sand">
          Horarios pensados para que llegues tranquilo y disfrutes desde el primer día.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-7">
        <div class="reveal-on-scroll rounded-[12px] border border-[var(--border-soft)] bg-surface p-6 sm:p-8">
          <span class="label-kicker block">Check-in</span>
          <p class="mt-2 font-serif text-4xl font-semibold tracking-[-0.01em] text-cream">
            14:00 hs
          </p>
          <p class="mt-2 text-sm leading-relaxed text-sand">
            Ingreso desde las 2 de la tarde.
          </p>
        </div>

        <div class="reveal-on-scroll rounded-[12px] border border-[var(--border-soft)] bg-surface p-6 sm:p-8">
          <span class="label-kicker block">Check-out</span>
          <p class="mt-2 font-serif text-4xl font-semibold tracking-[-0.01em] text-cream">
            10:00 hs
          </p>
          <p class="mt-2 text-sm leading-relaxed text-sand">
            Egreso hasta las 10 de la mañana.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
