---
interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
const isFooter = variant === 'footer';
---

<span class="inline-flex items-center gap-3 leading-none select-none">
  <img
    src="/LogoAVN.png"
    alt="AVN – Alquiler de Verano Necochea"
    width="48"
    height="48"
    loading="eager"
    decoding="async"
    class={`shrink-0 rounded-[8px] object-contain ${
      isFooter ? 'h-12 w-12' : 'h-11 w-11 shadow-xs'
    }`}
  />
  {
    isFooter && (
      <span class="font-sans text-sm font-normal text-dark-muted">
        Alquiler de verano en Necochea
      </span>
    )
  }
</span>
