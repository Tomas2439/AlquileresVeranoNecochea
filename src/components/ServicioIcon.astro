---
import type { ServicioIcono } from '../data/alojamientos';

interface Props {
  icono: ServicioIcono;
}

const { icono } = Astro.props;
---

{
  icono === 'plantas' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 20h5v-5h5v-5h6" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12l8-6 8 6" />
    </svg>
  )
}
{
  icono === 'dormitorios' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v11" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 14h18v4" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 14v-3a2 2 0 0 1 2-2h9a3 3 0 0 1 3 3v2" />
    </svg>
  )
}
{
  icono === 'cocina' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 3v7a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V3" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3v18" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 3v18" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 3c2.2 0 4 1.8 4 4.5S18.2 12 16 12" />
    </svg>
  )
}
{
  icono === 'parrilla' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 3 4 5.5 4 8a4 4 0 1 1-8 0c0-1.6.7-3.2 1.8-4.7" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 18h14" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10" />
    </svg>
  )
}
{
  icono === 'wifi' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12.55a11 11 0 0 1 14.08 0" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.53 16.11a6 6 0 0 1 6.95 0" />
      <circle cx="12" cy="19.5" r="1" fill="currentColor" />
    </svg>
  )
}
{
  icono === 'cochera' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 16l1.5-5.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 16" />
      <rect x="3" y="15" width="18" height="4" rx="1" />
      <circle cx="7" cy="19" r="1.5" />
      <circle cx="17" cy="19" r="1.5" />
    </svg>
  )
}
{
  icono === 'arbolado' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-6" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l6 8h-3l4 5H5l4-5H6l6-8Z" />
    </svg>
  )
}
{
  icono === 'llave' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="7.5" cy="15.5" r="4" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.8 12.2L20 3" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 6l3 3" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 8.5l2.5 2.5" />
    </svg>
  )
}
{
  icono === 'ambientes' && (
    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 9.5V20h14V9.5" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 20v-6h6v6" />
    </svg>
  )
}
