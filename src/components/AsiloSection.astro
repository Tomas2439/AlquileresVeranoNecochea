---
import { Image } from 'astro:assets';
import {
  getUnidadesByAsilo,
  WHATSAPP_URL,
  type AsiloGrupo,
} from '../data/alojamientos';
import { getFolderImages } from '../utils/media';

interface Props {
  asilo: AsiloGrupo;
  index: number;
}

const { asilo, index } = Astro.props;
const unidades = getUnidadesByAsilo(asilo);
const firstUnit = unidades[0];
const images = unidades.flatMap((u) => getFolderImages(u.slug));
const coverImage = images[0];
const coverAlt =
  firstUnit?.fotosAlt[0] ?? `${asilo.nombre} en ${asilo.zona}`;

const isAlt = index % 2 === 1;
const detailHref = `/asilos/${asilo.slug}`;
---

<section
  id={asilo.slug}
  class={`border-b border-[var(--border-soft)] py-16 sm:py-24 ${
    isAlt ? 'bg-bg-deep' : 'bg-bg'
  }`}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <div class={`lg:col-span-7 ${isAlt ? 'lg:order-2' : ''}`}>
        <a
          href={detailHref}
          aria-label={`Ver detalles y galería de ${asilo.nombre}`}
          class="group relative block aspect-[4/3] w-full overflow-hidden rounded-[12px] border border-[var(--border-soft)] bg-surface shadow-[var(--shadow-warm)]"
        >
          {
            coverImage ? (
              <Image
                src={coverImage}
                alt={coverAlt}
                loading="lazy"
                widths={[480, 840]}
                sizes="(max-width: 1024px) 100vw, 58vw"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-surface p-6 text-center">
                <span class="label-kicker rounded-[10px] border border-[var(--border-soft)] bg-bg-deep px-3 py-1.5">
                  FOTO PENDIENTE – {asilo.slug}
                </span>
              </div>
            )
          }
        </a>
      </div>

      <div class={`lg:col-span-5 ${isAlt ? 'lg:order-1' : ''}`}>
        <h2
          class="font-serif font-medium tracking-[-0.015em] text-cream"
          style="font-size: var(--text-h2); line-height: 1.08;"
        >
          {asilo.nombre}
        </h2>
        <span class="label-kicker mt-2 block">{asilo.zona}</span>

        <ul class="mt-6 space-y-2.5 border-y border-[var(--border-soft)] py-5">
          {
            unidades.map((unidad) => (
              <li class="flex items-baseline justify-between gap-4 text-base">
                <span class="font-medium text-cream">{unidad.nombre}</span>
                <span class="label-kicker">{unidad.capacidad}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-5 text-sm leading-relaxed text-sand">
          {asilo.ubicacionDetalle}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          <a href={detailHref} class="btn-primary">
            Ver detalles y fotos
          </a>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-[10px] border border-[var(--border-soft)] bg-surface px-4 py-3 text-sm font-medium text-cream hover:border-sand"
          >
            Consultar disponibilidad
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
