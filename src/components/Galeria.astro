---
import { getImage } from 'astro:assets';
import { ALOJAMIENTOS } from '../data/alojamientos';
import { getFolderImages } from '../utils/media';

interface GaleriaFoto {
  src: string;
  thumbSrc: string;
  alt: string;
}

interface GaleriaItem {
  slug: string;
  nombre: string;
  fotos: GaleriaFoto[];
}

const galeriaItems: GaleriaItem[] = await Promise.all(
  ALOJAMIENTOS.map(async (unidad) => {
    const rawImages = getFolderImages(unidad.slug);
    const fotos = await Promise.all(
      rawImages.map(async (img, index) => {
        const optimized = await getImage({ src: img, width: 1600, format: 'webp' });
        const thumb = await getImage({ src: img, width: 200, format: 'webp' });
        return {
          src: optimized.src,
          thumbSrc: thumb.src,
          alt:
            unidad.fotosAlt[index] ??
            `Ambiente de ${unidad.tipo} ${unidad.nombre}`,
        };
      })
    );

    return {
      slug: unidad.slug,
      nombre: unidad.nombre,
      fotos,
    };
  })
);
---

<div
  id="avn-galeria-lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="galeria-titulo"
  aria-hidden="true"
  style="background-color: rgba(20, 15, 12, 0.95);"
  class="fixed inset-0 z-50 hidden h-dvh w-screen flex-col justify-between overflow-hidden select-none"
>
  <!-- Encabezado compacto: nombre a la izquierda, contador "3 / 8" y botón cerrar a la derecha -->
  <div class="flex h-16 shrink-0 items-center justify-between gap-4 px-4 sm:px-6">
    <h3
      id="galeria-titulo"
      class="truncate font-serif text-xl font-semibold text-dark-text sm:text-2xl"
    >
    </h3>

    <div class="flex shrink-0 items-center gap-3">
      <span
        id="galeria-contador"
        aria-live="polite"
        class="min-w-[3.75rem] text-right text-sm font-medium whitespace-nowrap text-dark-muted"
      >
      </span>

      <button
        type="button"
        id="galeria-cerrar"
        aria-label="Cerrar galería"
        class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[var(--border-dark)] bg-white/10 text-dark-text hover:bg-white/20"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Visor central: imagen siempre entera, sin marco blanco ni scroll interno -->
  <div
    id="galeria-stage"
    class="relative flex min-h-0 flex-1 items-center justify-center px-4 sm:px-16"
  >
    <button
      type="button"
      id="galeria-prev"
      aria-label="Foto anterior"
      class="absolute top-1/2 left-3 z-20 hidden h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[var(--border-dark)] bg-white/10 text-dark-text hover:bg-white/25 sm:inline-flex"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
      </svg>
    </button>

    <img
      id="galeria-imagen"
      alt=""
      style="max-width: 100%; max-height: calc(100dvh - 160px); object-fit: contain;"
      class="hidden h-auto w-auto rounded-[4px]"
    />

    <button
      type="button"
      id="galeria-next"
      aria-label="Foto siguiente"
      class="absolute top-1/2 right-3 z-20 hidden h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-[var(--border-dark)] bg-white/10 text-dark-text hover:bg-white/25 sm:inline-flex"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>

  <!-- Tira de miniaturas inferior compacta -->
  <div
    id="galeria-thumbs"
    class="no-scrollbar flex h-20 shrink-0 items-center justify-center gap-2 overflow-x-auto px-4 pb-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
  </div>
</div>

<script type="application/json" id="avn-galeria-data" set:html={JSON.stringify(galeriaItems)}></script>

<script>
  interface GaleriaFoto {
    src: string;
    thumbSrc: string;
    alt: string;
  }
  interface GaleriaItem {
    slug: string;
    nombre: string;
    fotos: GaleriaFoto[];
  }

  const dataEl = document.getElementById('avn-galeria-data');
  const lightbox = document.getElementById('avn-galeria-lightbox');

  if (dataEl && lightbox) {
    const items: GaleriaItem[] = JSON.parse(dataEl.textContent || '[]');
    const bySlug = new Map(items.map((item) => [item.slug, item]));

    const titleEl = document.getElementById('galeria-titulo');
    const imgEl = document.getElementById('galeria-imagen') as HTMLImageElement | null;
    const stageEl = document.getElementById('galeria-stage');
    const contadorEl = document.getElementById('galeria-contador');
    const thumbsEl = document.getElementById('galeria-thumbs');
    const prevBtn = document.getElementById('galeria-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('galeria-next') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('galeria-cerrar') as HTMLButtonElement | null;

    let currentItem: GaleriaItem | null = null;
    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;

    function buildThumbs() {
      if (!thumbsEl || !currentItem) return;
      thumbsEl.innerHTML = '';
      if (currentItem.fotos.length <= 1) {
        thumbsEl.classList.add('hidden');
        return;
      }
      thumbsEl.classList.remove('hidden');

      currentItem.fotos.forEach((foto, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-label', `Foto ${idx + 1}`);
        btn.className = `aspect-[4/3] h-12 shrink-0 cursor-pointer overflow-hidden rounded-[6px] border-2 transition-opacity ${
          idx === currentIndex
            ? 'border-white opacity-100'
            : 'border-transparent opacity-50 hover:opacity-85'
        }`;
        const thumbImg = document.createElement('img');
        thumbImg.src = foto.thumbSrc;
        thumbImg.alt = '';
        thumbImg.className = 'h-full w-full object-cover';
        btn.appendChild(thumbImg);
        btn.addEventListener('click', () => {
          currentIndex = idx;
          renderSlide();
        });
        thumbsEl.appendChild(btn);
        if (idx === currentIndex) {
          requestAnimationFrame(() => {
            btn.scrollIntoView({ inline: 'center', block: 'nearest' });
          });
        }
      });
    }

    function renderSlide() {
      if (!currentItem || !imgEl || !contadorEl || !prevBtn || !nextBtn) return;

      const fotos = currentItem.fotos;
      if (fotos.length === 0) return;

      const foto = fotos[currentIndex];
      imgEl.src = foto.src;
      imgEl.alt = foto.alt;
      imgEl.classList.remove('hidden');

      contadorEl.textContent = `${currentIndex + 1} / ${fotos.length}`;
      const hasMultiple = fotos.length > 1;
      prevBtn.classList.toggle('sm:inline-flex', hasMultiple);
      nextBtn.classList.toggle('sm:inline-flex', hasMultiple);
      buildThumbs();
    }

    function openGaleria(slug: string, initialIndex = 0, triggerEl: HTMLElement | null = null) {
      const item = bySlug.get(slug);
      if (!item || item.fotos.length === 0 || !titleEl || !lightbox) return;

      lastTrigger = triggerEl;
      currentItem = item;
      currentIndex = Math.max(0, Math.min(initialIndex, item.fotos.length - 1));
      titleEl.textContent = item.nombre;
      renderSlide();

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeGaleria() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastTrigger?.focus();
    }

    function step(delta: number) {
      if (!currentItem || currentItem.fotos.length <= 1) return;
      const len = currentItem.fotos.length;
      currentIndex = (currentIndex + delta + len) % len;
      renderSlide();
    }

    document.querySelectorAll<HTMLElement>('[data-open-galeria]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const slug = trigger.getAttribute('data-open-galeria');
        const idxAttr = trigger.getAttribute('data-photo-index');
        const startIdx = idxAttr ? Number(idxAttr) || 0 : 0;
        if (slug) openGaleria(slug, startIdx, trigger);
      });
    });

    closeBtn?.addEventListener('click', closeGaleria);
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    stageEl?.addEventListener('click', (event) => {
      if (event.target === stageEl) {
        closeGaleria();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeGaleria();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });

    // Swipe horizontal en mobile
    let touchStartX = 0;
    let touchStartY = 0;

    stageEl?.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    stageEl?.addEventListener(
      'touchend',
      (event) => {
        const deltaX = event.changedTouches[0].screenX - touchStartX;
        const deltaY = event.changedTouches[0].screenY - touchStartY;
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
          if (deltaX < 0) step(1);
          else step(-1);
        }
      },
      { passive: true }
    );
  }
</script>
