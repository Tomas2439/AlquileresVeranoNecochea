---
import { Image } from 'astro:assets';
import type { Alojamiento } from '../data/alojamientos';
import { getFolderImages, getFolderVideos } from '../utils/media';
import ServicioIcon from './ServicioIcon.astro';

interface Props {
  unidad: Alojamiento;
  layout?: 'vertical' | 'horizontal';
}

const { unidad, layout = 'vertical' } = Astro.props;
const images = getFolderImages(unidad.slug);
const folderVideos = getFolderVideos(unidad.slug);
const coverIdx = unidad.portadaIndex ?? 0;
const coverImage = images[coverIdx] ?? images[0];
const coverVideo = !coverImage ? folderVideos[0] : undefined;
const posterTime = unidad.videoPosterTime ?? 1.5;
const coverAlt =
  unidad.fotosAlt[coverIdx] ?? unidad.fotosAlt[0] ?? `${unidad.tipo} ${unidad.nombre} en Necochea`;
const detailHref = `/alojamientos/${unidad.slug}`;
const isHorizontal = layout === 'horizontal';
const videoCount = folderVideos.length + (unidad.videos?.length ?? 0);
const mediaBadgeParts = [
  images.length > 0 ? `${images.length} ${images.length === 1 ? 'foto' : 'fotos'}` : '',
  videoCount > 0 ? `${videoCount === 1 ? '1 video' : `${videoCount} videos`}` : '',
].filter(Boolean);
const mediaBadge = mediaBadgeParts.join(' · ');
---

<article
  class={`reveal-on-scroll overflow-hidden rounded-[12px] border border-border bg-surface shadow-[var(--shadow-warm)] ${
    isHorizontal ? 'grid grid-cols-1 md:grid-cols-2 md:items-center' : 'flex h-full flex-col'
  }`}
>
  <div
    class={`relative w-full overflow-hidden bg-bg ${
      isHorizontal ? 'aspect-[3/2] md:aspect-[16/10] md:h-full' : 'aspect-[4/3]'
    }`}
  >
    {
      coverImage ? (
        <Image
          src={coverImage}
          alt={coverAlt}
          loading="lazy"
          widths={[480, 800]}
          sizes="(max-width: 768px) 100vw, 48vw"
          style={unidad.portadaPosition ? `object-position: ${unidad.portadaPosition};` : undefined}
          class="h-full w-full object-cover"
        />
      ) : coverVideo ? (
        <video
          src={`${coverVideo}#t=${posterTime}`}
          muted
          playsinline
          preload="metadata"
          aria-label={`Vista previa de ${unidad.nombre}`}
          class="h-full w-full object-cover"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center p-6"
          style="background: var(--photo-fallback);"
          aria-hidden="true"
        >
          <svg
            class="h-14 w-14 text-accent/45"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 34L32 14l24 20" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 30v22h36V30" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 56c8-3 16-3 26 0s18 3 26 0" />
          </svg>
        </div>
      )
    }

    {
      mediaBadge && (
        <span class="pointer-events-none absolute right-3 bottom-3 rounded-[8px] border border-border bg-surface/95 px-2.5 py-1 text-sm font-medium whitespace-nowrap text-text">
          {mediaBadge}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div>
      <p class="text-sm font-medium text-accent">
        {unidad.tipo} · {unidad.capacidad}
      </p>
      <h4
        class="mt-1.5 font-serif font-semibold tracking-[-0.01em] text-text"
        style="font-size: var(--text-h3); line-height: 1.2;"
      >
        {unidad.nombre}
      </h4>
      <p class="mt-2 min-h-[2.5rem] text-xs leading-relaxed text-text-muted">
        {unidad.diferencial}
      </p>

      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-border pt-4">
        {
          unidad.servicios.slice(0, 4).map((servicio) => (
            <li class="flex items-center gap-2 text-sm text-text">
              <ServicioIcon icono={servicio.icono} />
              <span>{servicio.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class={isHorizontal ? 'mt-5' : 'mt-auto pt-6'}>
      <a href={detailHref} class="btn-secondary w-full sm:w-auto">
        Ver fotos y detalles
      </a>
    </div>
  </div>
</article>
