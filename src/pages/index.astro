---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Alojamientos from '../components/Alojamientos.astro';
import InfoEstadia from '../components/InfoEstadia.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
---

<Layout>
  <Header />
  <main id="contenido-principal" class="flex-1">
    <Hero />
    <Alojamientos />
    <InfoEstadia />
    <Ubicacion />
    <CtaWhatsapp />
  </main>
  <Footer />
  <WhatsappFloat />
</Layout>
